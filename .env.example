POSTGRES_DB=ai_sre
POSTGRES_USER=ai_sre
POSTGRES_PASSWORD=local-development-only
INVESTIGATION_PORT=8000
TOOL_GATEWAY_PORT=8081
TOOL_GATEWAY_GRPC_PORT=9091
GATEWAY_AUTH_TOKEN=local-development-token
WEB_PORT=5173

# OpenAI-compatible model endpoint; leave blank to keep durable investigation APIs disabled.
AI_SRE_MODEL_BASE_URL=
AI_SRE_MODEL_API_KEY=
AI_SRE_MODEL_ID=
AI_SRE_INVESTIGATION_WORKERS=5

# Optional stage-4 embedding endpoint; base URL and key fall back to the model values above.
AI_SRE_EMBEDDING_BASE_URL=
AI_SRE_EMBEDDING_API_KEY=
AI_SRE_EMBEDDING_MODEL_ID=
# Set only when the provider supports selecting output dimensions.
AI_SRE_EMBEDDING_DIMENSIONS=

# Generated by `make eval-offline`; mounted read-only for the Web quality report.
AI_SRE_EVALUATION_REPORT_PATH=artifacts/stage6-report.json
